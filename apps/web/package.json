{
  "name": "@jsk/web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend SPA — routes mirror Spec §20 observed routes",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
