{
  "name": "@jsk/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Same codebase as api, worker entrypoint for Phase 9 jobs (Spec §26)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage"
  },
  "dependencies": {
    "@jsk/shared-kernel": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^18.19.0"
  }
}