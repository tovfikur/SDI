{
  "name": "@jsk/api",
  "version": "0.1.0",
  "private": true,
  "description": "Modular monolith API — HTTP layer, controllers, DTO validation (Spec §26)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage"
  },
  "dependencies": {
    "@jsk/domain-attendance": "*",
    "@jsk/domain-audit": "*",
    "@jsk/domain-hr": "*",
    "@jsk/domain-leave": "*",
    "@jsk/domain-projects": "*",
    "@jsk/domain-todos": "*",
    "@jsk/shared-auth": "*",
    "@jsk/shared-kernel": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "dotenv": "^17.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@jsk/domain-files": "*",
    "@jsk/domain-notifications": "*",
    "@jsk/domain-payroll": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
