# ============================================================================
# JSK HRM & PM — PRODUCTION environment template
# Copy to `.env` next to the API entrypoint (apps/api/.env) or export the
# variables into your process manager. NEVER commit real secrets.
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=production
# Public origin of the web app (used for CORS + cookie scope)
PUBLIC_WEB_ORIGIN=https://hrm.example.com
# Generate with: openssl rand -hex 32
SESSION_SECRET=<openssl-rand-hex-32>
# Cookies MUST be secure in production (HTTPS only)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ---- Database (PostgreSQL 15+) ---------------------------------------------
DATABASE_URL=postgres://jsk:<strong-db-password>@<db-host>:5432/jsk

# ---- Redis (background jobs) ------------------------------------------------
REDIS_URL=redis://<redis-host>:6379

# ---- Object storage (MinIO or any S3-compatible store) ---------------------
S3_ENDPOINT=https://<minio-host>:9000
S3_ACCESS_KEY=<minio-access-key>
S3_SECRET_KEY=<minio-secret-key>
S3_BUCKET=jsk-files
S3_FORCE_PATH_STYLE=true

# ---- SMTP (transactional email) ---------------------------------------------
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM="JSK HRM <no-reply@example.com>"

# ---- Frontend build-time variable (baked by Vite, NOT runtime) -------------
# Set when building apps/web. Same-origin proxy (recommended):
#   VITE_API_URL=""            → relative /api calls through nginx
# Split-origin alternative:
#   VITE_API_URL=https://api.example.com
