# JSK HRM & PM — local development environment (Spec Phase 20, "Local")
# Storage/email adapters are mocked locally: MinIO (S3-compatible) + Mailpit (SMTP catch-all).
# Copy to .env (same directory) and fill in real secrets before first `docker compose up`.

# ---- app ----
NODE_ENV=development
PUBLIC_WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-session-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---- postgres ----
POSTGRES_DB=jsk
POSTGRES_USER=jsk
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432

# ---- redis ----
REDIS_PORT=6379

# ---- minio (local S3-compatible storage) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jskminio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=jsk-files
S3_FORCE_PATH_STYLE=true

# ---- smtp (mailpit catch-all) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=jsk@example.com
EMAIL_SSL=false

# ---- feature flags (Phase 9 / Phase 12) ----
FEATURE_FLAG_DOCS=false
FEATURE_FLAG_RECURRENCE=false
FEATURE_FLAG_INTERNAL_CHAT=true